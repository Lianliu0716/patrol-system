    <ContentPage.Content>
        <StackLayout>
            
            <Grid VerticalOptions="FillAndExpand"  HorizontalOptions="FillAndExpand" Padding="20,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="6*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <Label  
                    Text="Welcome to Patrol System!"
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center"
                    FontSize="23"/>

            <Grid Grid.Row="1" Grid.ColumnSpan="2">

                <Image
                        Source="placeholder.png"
                    x:Name="image"
                        Aspect="Fill"
                    
                    />
            </Grid>
        </Grid>

        <Button
                    Text="Start"
                    BackgroundColor="Gray"
                    TextColor="White"
                    WidthRequest="150"
                    HeightRequest="50"
                    VerticalOptions="Center"
                    Grid.Row="2"
                    CornerRadius="10"
                    Grid.ColumnSpan="2"
                    Padding="5"
                    Clicked="Page1"
                    
                    />

        </StackLayout>
    </ContentPage.Content>
