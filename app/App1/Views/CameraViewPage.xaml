                <Label Text="On" TextColor="White" FontSize="14" VerticalOptions="Center" x:Name="Mode"/>
                <StackLayout Orientation="Horizontal">
                    <Switch IsToggled="True" Toggled="Switch_Toggled" x:Name="switchMode" VerticalOptions="Center"/>
                </StackLayout>
        
                <Button Text="Capture" Clicked="CaptureImage" x:Name="captureBtn"/>
            
